# 운영 .env.production 템플릿.
# 실제 값은 이 파일이 아니라 서버에만 있는 .env.production에 채운다. 여기엔 절대 실값 넣지 말 것.
# docker-compose.yml의 firesafety-backend/ai-service가 이 파일을 env_file로 읽는다.

# docker-compose 내부 네트워크 기준 (호스트명은 서비스명 mysql — container_name과는 별개)
# DB명은 arcguard_db (기존 로컬 테스트 DB와 구분되는 신규 운영 DB, 데이터 이전 없이 Flyway가 빈 DB에 생성)
DB_URL=jdbc:mysql://mysql:3306/arcguard_db
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

JWT_ISSUER=firesafety
JWT_BEARER_FORMAT=JWT
JWT_CLAIM_KEY=user
JWT_SECRET_KEY=replace_with_base64url_encoded_secret
JWT_ACCESS_TOKEN_COOKIE_NAME=at
JWT_ACCESS_TOKEN_COOKIE_PATH=/
JWT_ACCESS_TOKEN_COOKIE_VALIDITY_SECONDS=3600
JWT_ACCESS_TOKEN_VALIDITY_MILLISECONDS=3600000
JWT_REFRESH_TOKEN_COOKIE_NAME=rt
JWT_REFRESH_TOKEN_COOKIE_PATH=/api/auth
JWT_REFRESH_TOKEN_COOKIE_VALIDITY_SECONDS=604800
JWT_REFRESH_TOKEN_VALIDITY_MILLISECONDS=604800000
# HTTP 1차 배포: false (브라우저가 HTTP에서는 Secure 쿠키를 저장 안 함)
# HTTPS 2차 전환 후: true로 변경
JWT_COOKIE_SECURE=false
# 두 단계 모두 Lax 유지
JWT_COOKIE_SAME_SITE=Lax

# 프론트가 실제로 접속하는 주소(IP 또는 도메인, 포트 없이 80/443 기준). 서버 IP나 도메인이 바뀔 때마다
# 이 값만 바꾸면 됨(재빌드 불필요, backend 컨테이너만 재기동). 콤마로 여러 개 지정 가능.
# 참고: nginx가 frontend/backend를 같은 origin(arcguard.duckdns.org)으로 묶어 서빙하므로 브라우저가
# 보내는 일반적인 API 호출은 same-origin이라 이 값이 실제로 검사되지 않는다. 그래도 IP로 직접
# 접근하거나 Swagger UI에서 별도 오리진으로 테스트하는 경우를 위해 실제 운영 도메인으로 맞춰둔다.
# 운영 도메인 확정(Phase 15): arcguard.duckdns.org. HTTPS 전환 후에는 https://arcguard.duckdns.org로 교체할 것.
CORS_ALLOWED_ORIGINS=http://arcguard.duckdns.org

# 최초 배포 시에만 true로 계정 생성 후 false로 되돌릴 것
BOOTSTRAP_SUPER_ADMIN_ENABLED=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=최고관리자
BOOTSTRAP_SUPER_ADMIN_PHONE=

# FIREBASE_CREDENTIALS_PATH는 컨테이너 내부 경로다 - docker-compose.yml의 backend 볼륨 마운트
# (./secrets/firebase-credentials.json:/app/secrets/firebase-credentials.json:ro)와 반드시 일치해야
# 한다(마운트 경로가 바뀌면 이 값도 같이 바꿀 것). 호스트 파일은 컨테이너가 non-root(firesafety)
# 사용자로 실행되므로 다른 사용자도 읽을 수 있는 권한이어야 한다.
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-credentials.json

# ai-service 컨테이너와 내부 네트워크로만 통신 (외부 노출 없음)
AI_PREDICTION_ENABLED=false
AI_PREDICTION_BASE_URL=http://ai-service:8000
AI_PREDICTION_PATH=/predict
AI_PREDICTION_MIN_SAMPLE_SIZE=30
AI_PREDICTION_SAMPLE_SIZE=60
AI_PREDICTION_SCHEDULER_DELAY_MS=60000
AI_PREDICTION_SCHEDULER_INITIAL_DELAY_MS=60000

# LLM 진단 설명(POST /explain) 기능. 기본값은 false - 공개 데모에서 실제 켤 계획이면 서버의
# 실 .env.production에서만 true로 바꾼다(이 example 파일 기본값은 계속 false로 둔다).
# OPENAI_API_KEY는 여기(Spring Boot)가 아니라 ai-service 전용 .env.production에만 존재한다.
AI_EXPLANATION_ENABLED=false
AI_EXPLAIN_PATH=/explain

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS=change-me
MAIL_FROM_NAME=아크가드 ArcGuard

# 비밀번호 재설정 메일의 링크로 그대로 쓰인다. 운영 도메인 확정(Phase 15): arcguard.duckdns.org.
# HTTPS 전환 후에는 https://arcguard.duckdns.org/reset-password로 교체할 것(다음 Phase, 별도 작업).
PASSWORD_RESET_BASE_URL=http://arcguard.duckdns.org/reset-password
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=10
PASSWORD_RESET_RATE_LIMIT_MAX_COUNT=5

COMMUNICATION_LOST_CHECK_DELAY_MS=30000
COMMUNICATION_LOST_CHECK_INITIAL_DELAY_MS=30000

# 운영에서는 반드시 false (실제 장비 연결)
SENSOR_MOCK_ENABLED=false
SENSOR_MOCK_DELAY_MS=5000
SENSOR_MOCK_AI_DELAY_MS=5000
