<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.arcguard.firesafety.inspection.mapper.InspectionMapper">
    <resultMap id="inspectionItemResResultMap" type="com.arcguard.firesafety.inspection.dto.res.InspectionItemRes">
        <id property="itemId" column="item_id"/>
        <result property="siteId" column="site_id"/>
        <result property="itemName" column="item_name"/>
        <result property="description" column="description"/>
    </resultMap>

    <resultMap id="inspectionHistoryResResultMap" type="com.arcguard.firesafety.inspection.dto.res.InspectionHistoryRes">
        <id property="inspectionId" column="inspection_id"/>
        <result property="inspectedAt" column="inspected_at"/>
        <result property="inspectorName" column="inspector_name"/>
        <result property="note" column="note"/>
    </resultMap>

    <resultMap id="inspectionResultItemResResultMap" type="com.arcguard.firesafety.inspection.dto.res.InspectionResultItemRes">
        <result property="itemId" column="item_id"/>
        <result property="itemName" column="item_name"/>
        <result property="result" column="result"/>
    </resultMap>

    <resultMap id="inspectionExportRowResResultMap" type="com.arcguard.firesafety.inspection.dto.res.InspectionExportRowRes">
        <id property="inspectionId" column="inspection_id"/>
        <result property="siteName" column="site_name"/>
        <result property="panelName" column="panel_name"/>
        <result property="mNo" column="m_no"/>
        <result property="inspectedAt" column="inspected_at"/>
        <result property="inspectorName" column="inspector_name"/>
        <result property="itemId" column="item_id"/>
        <result property="itemName" column="item_name"/>
        <result property="description" column="description"/>
        <result property="result" column="result"/>
        <result property="note" column="note"/>
    </resultMap>

    <!-- 점검 항목 등록 (현장 카탈로그) -->
    <insert id="insertInspectionItem"
            parameterType="com.arcguard.firesafety.inspection.model.InspectionItem"
            useGeneratedKeys="true"
            keyProperty="itemId">
        INSERT INTO inspection_item (site_id, item_name, description)
        VALUES (#{siteId}, #{itemName}, #{description})
    </insert>

    <!-- 점검 항목 수정 (현장 카탈로그) -->
    <update id="updateInspectionItem" parameterType="com.arcguard.firesafety.inspection.model.InspectionItem">
        UPDATE inspection_item
        SET item_name = #{itemName}, description = #{description}
        WHERE item_id = #{itemId}
    </update>

    <!-- 점검 항목 삭제 (현장 카탈로그) -->
    <delete id="deleteInspectionItem">
        DELETE FROM inspection_item WHERE item_id = #{itemId}
    </delete>

    <!-- 점검 항목이 어느 분전반에든 적용돼 있는지 확인 -->
    <select id="existsPanelInspectionItemByItemId" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM panel_inspection_item WHERE item_id = #{itemId})
    </select>

    <!-- 점검 항목이 점검 결과에 이미 쓰인 적 있는지 확인 -->
    <select id="existsInspectionResultItemByItemId" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM inspection_result_item WHERE item_id = #{itemId})
    </select>

    <!-- 현장의 점검 항목 카탈로그 전체 조회 -->
    <select id="findInspectionItemsBySiteId" resultMap="inspectionItemResResultMap">
        SELECT item_id, site_id, item_name, description
        FROM inspection_item
        WHERE site_id = #{siteId}
        ORDER BY item_id ASC
    </select>

    <!-- 분전반에 적용된 점검 항목 목록 조회 -->
    <select id="findInspectionItemsByPanelId" resultMap="inspectionItemResResultMap">
        SELECT i.item_id, i.site_id, i.item_name, i.description
        FROM inspection_item i
        INNER JOIN panel_inspection_item pii ON pii.item_id = i.item_id
        WHERE pii.panel_id = #{panelId}
        ORDER BY i.item_id ASC
    </select>

    <!-- 점검 항목이 해당 현장 카탈로그 소속인지 확인 (분전반 적용 시 다른 현장 항목 섞이는 것 방지) -->
    <select id="existsInspectionItemInSite" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM inspection_item
            WHERE item_id = #{itemId} AND site_id = #{siteId}
        )
    </select>

    <!-- 점검 항목이 해당 분전반에 적용된 상태인지 확인 (체크리스트 저장 시 유효성 검증용) -->
    <select id="existsInspectionItem" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM panel_inspection_item
            WHERE item_id = #{itemId} AND panel_id = #{panelId}
        )
    </select>

    <!-- 분전반에 적용된 점검 항목 전체 삭제 (전체교체의 delete 단계) -->
    <delete id="deletePanelInspectionItems">
        DELETE FROM panel_inspection_item WHERE panel_id = #{panelId}
    </delete>

    <!-- 분전반에 점검 항목 일괄 적용 (전체교체의 insert 단계) -->
    <insert id="insertPanelInspectionItems">
        INSERT INTO panel_inspection_item (panel_id, item_id)
        VALUES
        <foreach collection="itemIds" item="itemId" separator=",">
            (#{panelId}, #{itemId})
        </foreach>
    </insert>

    <!-- 점검 실행 1건 등록 -->
    <insert id="insertInspectionResult"
            parameterType="com.arcguard.firesafety.inspection.model.InspectionResult"
            useGeneratedKeys="true"
            keyProperty="inspectionId">
        INSERT INTO inspection_result (panel_id, inspected_at, inspector_id, note)
        VALUES (#{panelId}, #{inspectedAt}, #{inspectorId}, #{note})
    </insert>

    <!-- 점검 실행 1건에 딸린 항목별 결과 등록 -->
    <insert id="insertInspectionResultItem" parameterType="com.arcguard.firesafety.inspection.model.InspectionResultItem">
        INSERT INTO inspection_result_item (inspection_id, item_id, result)
        VALUES (#{inspectionId}, #{itemId}, #{result})
    </insert>

    <sql id="inspectionHistoryFilter">
        <where>
            AND r.panel_id = #{panelId}
            <if test="fromAt != null">
                AND r.inspected_at &gt;= #{fromAt}
            </if>
            <if test="toAt != null">
                AND r.inspected_at &lt; #{toAt}
            </if>
        </where>
    </sql>

    <!-- 분전반의 점검 이력 목록 조회 (항목별 결과는 findResultItemsByInspectionId로 별도 조립) -->
    <select id="findInspectionHistory" resultMap="inspectionHistoryResResultMap">
        SELECT
            r.inspection_id,
            r.inspected_at,
            u.name AS inspector_name,
            r.note
        FROM inspection_result r
        LEFT JOIN `user` u ON u.user_id = r.inspector_id
        <include refid="inspectionHistoryFilter"/>
        ORDER BY r.inspected_at DESC, r.inspection_id DESC
        LIMIT #{size}
        OFFSET #{offset}
    </select>

    <!-- 점검 이력 전체 개수 조회 -->
    <select id="countInspectionHistory" resultType="long">
        SELECT COUNT(*)
        FROM inspection_result r
        <include refid="inspectionHistoryFilter"/>
    </select>

    <!-- 점검 실행 1건의 항목별 결과 조회 (항목명 포함) -->
    <select id="findResultItemsByInspectionId" resultMap="inspectionResultItemResResultMap">
        SELECT
            i.item_id,
            i.item_name,
            ri.result
        FROM inspection_result_item ri
        INNER JOIN inspection_item i ON i.item_id = ri.item_id
        WHERE ri.inspection_id = #{inspectionId}
        ORDER BY i.item_id ASC
    </select>

    <!-- 점검 이력 엑셀 다운로드: 점검 1건을 항목별 row로 펼쳐 조회 -->
    <select id="findInspectionExportRows" resultMap="inspectionExportRowResResultMap">
        SELECT
            r.inspection_id,
            s.name AS site_name,
            p.name AS panel_name,
            p.m_no,
            r.inspected_at,
            u.name AS inspector_name,
            i.item_id,
            i.item_name,
            i.description,
            ri.result,
            r.note
        FROM inspection_result r
        INNER JOIN panel p ON p.panel_id = r.panel_id
        INNER JOIN site s ON s.site_id = p.site_id
        LEFT JOIN `user` u ON u.user_id = r.inspector_id
        INNER JOIN inspection_result_item ri ON ri.inspection_id = r.inspection_id
        INNER JOIN inspection_item i ON i.item_id = ri.item_id
        <include refid="inspectionHistoryFilter"/>
        ORDER BY r.inspected_at DESC, r.inspection_id DESC, i.item_id ASC
    </select>
</mapper>
